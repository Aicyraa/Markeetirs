<div class="category">
   <div>
      <span> <%= category.name %> </span>
      <span> <%= category.description %> </span>
   </div>
   <div>
      <div>
         <% if (category.is_profitable === 'yes') { %>
            <!-- Good -->
            <img src="/trade-up-stroke-rounded.svg" alt="" width="30" height="30" />
         <% } else { %>
            <!-- BAD -->
            <img src="/trade-down-stroke-rounded.svg" alt="" width="30" height="30" />
         <% } %>
            <span> <%= category.total_profit %> </span>
      </div>
      <div>
         <span> <%= category.total_item %> </span>
      </div>
   </div>
</div>
